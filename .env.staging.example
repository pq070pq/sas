# Copy to .env.staging on the host. Never commit the populated file.
APP_ENV=staging
APP_BASE_URL=https://staging.YOUR-DOMAIN.example

# Set unique staging-only admin credentials before starting the staging service.
SAS_STANDALONE_ADMIN_USERNAME=CHANGE_THIS_ADMIN_NAME
SAS_STANDALONE_ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
SAS_STANDALONE_ADMIN_SESSION_HOURS=8
SAS_STANDALONE_ADMIN_COOKIE_SECURE=true

# Optional data-provider credentials. Use staging-specific keys/quotas where possible.
TWELVE_DATA_API_KEY=
TWELVE_DATA_API_KEYS=
FINNHUB_API_KEY=
FINNHUB_API_KEYS=
FMP_API_KEY=
FMP_API_KEYS=
NEWSFILTER_API_KEY=
MARKETAUX_API_KEY=
MARKETAUX_API_KEYS=
GROQ_API_KEY=
GROQ_API_KEYS=
GEMINI_API_KEY=
GEMINI_API_KEYS=
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=

# A real contact email is required by SEC fair-access policy if SEC disclosures are tested.
SEC_USER_AGENT=SAS PRO Staging contact: ops@YOUR-DOMAIN.example

# Telegram credentials are intentionally absent. Do not add production bot tokens here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_AUTO_CONFIGURE=false
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_LINK=
OWNER_TELEGRAM_ID=0

# Optional external integrations stay disabled unless separately configured for staging.
CRON_SECRET=
OPENTERMINAL_API_KEY=
SAS_TERMINAL_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=
