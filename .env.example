APP_ENV=production
APP_BASE_URL=https://YOUR-DOMAIN.example
DATABASE_URL=sqlite+aiosqlite:///./data/saspro.db
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_SHORT_NAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_AUTO_CONFIGURE=true
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_LINK=
OWNER_TELEGRAM_ID=
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
PANWATCH_BASE_URL=http://panwatch:8000
PANWATCH_TIMEOUT_SECONDS=180

# SAS PRO subscriptions
PRO_MONTHLY_STARS=2250
PRO_3MONTH_STARS=6075
PRO_6MONTH_STARS=10800
PRO_YEARLY_STARS=18900
MONTHLY_SAR=150
THREE_MONTH_SAR=405
SIX_MONTH_SAR=720
YEARLY_SAR=1260
TRIAL_DAYS=30
INVITE_HOURS=48
TRIAL_CHANNEL_ID=
EXPIRY_WARNING_HOURS=72

# SAS PRO AI news analysis
AI_RADAR_ENABLED=true
AI_RADAR_CONCURRENCY=2
AI_RADAR_TIMEOUT_SECONDS=25
AI_MAX_NEWS=5
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Radar / market
HOLIDAY_RADAR_INTERVAL_MINUTES=180
WEEKEND_RADAR_INTERVAL_MINUTES=180
MARKET_BRIEF_ENABLED=true
MARKET_BRIEF_WINDOW_MINUTES=65
RADAR_INTERVAL_MINUTES=30
TWELVE_DATA_SCAN_FALLBACK_SYMBOLS=3
TWELVE_DATA_INTRADAY_SYMBOLS=2
TWELVE_DATA_DAILY_REQUEST_CAP=30
TWELVE_DATA_RESERVE_CREDITS=100
MARKET_UPDATE_INTERVAL_MINUTES=30
CRON_SECRET=

# Google Sheets (optional; keep credentials out of source control)
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=Subscriptions
GOOGLE_SERVICE_ACCOUNT_JSON=

# Protected OpenTerminal
OPENTERMINAL_BASE_URL=https://terminal.YOUR-DOMAIN.example
OPENTERMINAL_API_URL=http://openterminal-api:4000
SAS_TERMINAL_SECRET=generate-a-long-random-secret
OPENTERMINAL_API_KEY=
OPENTERMINAL_BASE_PATH=/terminal
