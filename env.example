# ═══════════════ مفاتيح API ═══════════════
# Finnhub API Key (مجاني من finnhub.io)
FINNHUB_API_KEY=your_finnhub_api_key_here

# ═══════════════ تيليجرام ═══════════════
# توكن البوت من @BotFather
TELEGRAM_BOT_TOKEN=1234567890:your_bot_token_here

# معرف القناة
TELEGRAM_CHANNEL_ID=@your_channel_username

# ═══════════════ إعدادات الفلترة ═══════════════
MIN_PRICE=1.0
MAX_PRICE=20.0
MIN_CHANGE_PCT=15.0
MIN_VOLUME=2000000
COOLDOWN_HOURS=3
